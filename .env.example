POSTGRES_DB=hybrid_rag
POSTGRES_USER=hybrid_rag
POSTGRES_PASSWORD=replace_with_a_local_password
POSTGRES_PORT=5432

BACKEND_PORT=8000
FRONTEND_PORT=8080
VITE_API_BASE_URL=
DATABASE_URL=postgresql+psycopg://hybrid_rag:replace_with_a_local_password@db:5432/hybrid_rag

# Document ingestion
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
IMAGE_EMBEDDING_MODEL_NAME=sentence-transformers/clip-ViT-B-32
UPLOAD_MAX_BYTES=10485760
CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=50
MAX_DOCUMENT_CHUNKS=2000
RETRIEVAL_CANDIDATE_LIMIT=10000
RETRIEVAL_CANDIDATE_MULTIPLIER=4
RETRIEVAL_CANDIDATE_K=20
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_BATCH_SIZE=16

# Choose "groq" or "ollama". Ollama runs on the host machine.
LLM_PROVIDER=groq
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3-vl:2b
OLLAMA_TIMEOUT_SECONDS=300

# Required only when LLM_PROVIDER=groq.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Must be a vision-capable model enabled for your Groq account.
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_TIMEOUT_SECONDS=45
CHAT_HISTORY_MESSAGES=6
RAG_MAX_CONTEXT_CHARS=30000
